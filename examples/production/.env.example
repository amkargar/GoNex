# Generate distinct random values; this file is documentation, not automatically loaded.
DATABASE_DIALECT=postgres
HTTP_ADDRESS=127.0.0.1:8080
GONEX_ENV=production
# Export DATABASE_URL, GONEX_ADMIN_TOKEN and GONEX_READER_TOKEN through your secret manager.
# Tokens must be distinct and at least 32 bytes. Compose additionally needs POSTGRES_PASSWORD.
# The Compose database uses a private local network with sslmode=disable for this rehearsal only.

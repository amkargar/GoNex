package adapter

import (
 "context"
 transport "{{.Framework}}/http"
)

func Register(r transport.EndpointRegistrar, message func(context.Context) (string, error), prefix, suffix string) error {
 h := Handler{message: message}
 return transport.Routes(r,
  transport.Get(prefix+"/{{.Name}}", h.Handle).
   Name("{{.Name}}Message"+suffix).
   Summary(summary).
   Tags("{{.Name}}"){{if .DB}}.
   Errors(404, 503){{end}},
 )
}

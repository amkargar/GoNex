package adapter

import (
 "context"
 transport "{{.Framework}}/http"
)

func Register(r transport.EndpointRegistrar,message func(context.Context)(string,error),prefix,suffix string)error{
 return transport.Register(r,transport.Endpoint[Request,Response]{Method:"GET",Path:prefix+"/{{.Name}}",OperationID:"{{.Name}}Message"+suffix,Status:200,Summary:summary,Tags:[]string{"{{.Name}}"},{{if .DB}}Errors:[]int{404,503},{{end}}Handler:Handler{message:message}.Handle})
}

package config

import (
 "os"
 "{{.Framework}}/config"
)

func Load()config.Config{
 address:=os.Getenv("HTTP_ADDRESS")
 {{if .HTTPAddress}}if address==""{address="{{.HTTPAddress}}"}{{end}}
 return config.Config{Address:address,DisableHTTP:os.Getenv("GONEX_DISABLE_HTTP")=="1",DisableOpenAPI:os.Getenv("GONEX_DISABLE_OPENAPI")=="1"}
}
